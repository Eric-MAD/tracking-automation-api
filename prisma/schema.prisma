generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model agency_account {
  id                String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  google_id         String    @unique @db.VarChar(255)
  email             String    @unique @db.VarChar(255)
  access_token_enc  Bytes?
  refresh_token_enc Bytes
  token_expiry      DateTime? @db.Timestamptz(6)
  scopes            String[]  @default([])
  mcc_id            String?   @db.VarChar(50)
  gtm_account_id    String?   @db.VarChar(50)
  is_active         Boolean   @default(true)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @db.Timestamptz(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model api_logs {
  id               String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  setup_step_id    String?      @db.Uuid
  setup_id         String?      @db.Uuid
  project_id       String?      @db.Uuid
  service          String       @db.VarChar(50)
  method           String       @db.VarChar(10)
  endpoint         String
  request_payload  Json?
  response_payload Json?
  http_status_code Int?         @db.SmallInt
  response_time_ms Int?
  is_error         Boolean      @default(false)
  error_code       String?      @db.VarChar(100)
  created_at       DateTime     @default(now()) @db.Timestamptz(6)
  projects         projects?    @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  setups           setups?      @relation(fields: [setup_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  setup_steps      setup_steps? @relation(fields: [setup_step_id], references: [id], onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "idx_api_logs_created_at")
  @@index([is_error], map: "idx_api_logs_is_error")
  @@index([project_id], map: "idx_api_logs_project_id")
  @@index([service], map: "idx_api_logs_service")
  @@index([setup_id], map: "idx_api_logs_setup_id")
  @@index([setup_step_id], map: "idx_api_logs_setup_step_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model client_google_accounts {
  id                  String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  project_id          String    @db.Uuid
  service             String    @db.VarChar(50)
  external_account_id String    @db.VarChar(100)
  account_name        String?   @db.VarChar(255)
  access_level        String    @default("editor") @db.VarChar(50)
  is_linked           Boolean   @default(false)
  linked_at           DateTime? @db.Timestamptz(6)
  extra_config        Json?
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @default(now()) @db.Timestamptz(6)
  projects            projects  @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([project_id, service])
  @@index([is_linked], map: "idx_client_accounts_is_linked")
  @@index([project_id], map: "idx_client_accounts_project_id")
  @@index([service], map: "idx_client_accounts_service")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model projects {
  id                     String                   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                   String                   @db.VarChar(255)
  client_company         String?                  @db.VarChar(255)
  domain                 String                   @db.VarChar(255)
  industry               String                   @default("generic") @db.VarChar(50)
  status                 String                   @default("active") @db.VarChar(50)
  notes                  String?
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)
  api_logs               api_logs[]
  client_google_accounts client_google_accounts[]
  setups                 setups[]

  @@index([industry], map: "idx_projects_industry")
  @@index([status], map: "idx_projects_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model setup_steps {
  id             String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  setup_id       String     @db.Uuid
  step_name      String     @db.VarChar(100)
  step_order     Int        @db.SmallInt
  service        String     @db.VarChar(50)
  status         String     @default("pending") @db.VarChar(50)
  input_payload  Json?
  output_payload Json?
  error_message  String?
  retry_count    Int        @default(0) @db.SmallInt
  max_retries    Int        @default(3) @db.SmallInt
  started_at     DateTime?  @db.Timestamptz(6)
  completed_at   DateTime?  @db.Timestamptz(6)
  created_at     DateTime   @default(now()) @db.Timestamptz(6)
  api_logs       api_logs[]
  setups         setups     @relation(fields: [setup_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([service], map: "idx_setup_steps_service")
  @@index([setup_id], map: "idx_setup_steps_setup_id")
  @@index([status], map: "idx_setup_steps_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model setups {
  id               String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  project_id       String        @db.Uuid
  template_id      String?       @db.Uuid
  status           String        @default("pending") @db.VarChar(50)
  gtm_container_id String?       @db.VarChar(100)
  ga4_property_id  String?       @db.VarChar(100)
  ga4_stream_id    String?       @db.VarChar(100)
  ads_customer_id  String?       @db.VarChar(100)
  merchant_id      String?       @db.VarChar(100)
  error_summary    String?
  started_at       DateTime?     @db.Timestamptz(6)
  completed_at     DateTime?     @db.Timestamptz(6)
  duration_seconds Int?
  created_at       DateTime      @default(now()) @db.Timestamptz(6)
  api_logs         api_logs[]
  setup_steps      setup_steps[]
  projects         projects      @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  templates        templates?    @relation(fields: [template_id], references: [id], onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "idx_setups_created_at")
  @@index([project_id], map: "idx_setups_project_id")
  @@index([status], map: "idx_setups_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model templates {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name          String   @db.VarChar(255)
  service       String   @db.VarChar(50)
  industry_type String   @db.VarChar(50)
  description   String?
  config_json   Json
  version       String   @default("1.0.0") @db.VarChar(20)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)
  setups        setups[]

  @@index([industry_type], map: "idx_templates_industry_type")
  @@index([is_active], map: "idx_templates_is_active")
  @@index([service], map: "idx_templates_service")
}
